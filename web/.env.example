# Server-side only. NEVER prefix secrets with NEXT_PUBLIC_.
OPENAI_API_KEY=
# or ANTHROPIC_API_KEY=
MODEL_NAME=gpt-4o-mini
MAX_INPUT_CHARS=2000

# Supabase — fill after `supabase login` + `supabase link` (or paste from dashboard).
# Local defaults target `supabase start` (needs Docker Desktop).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
